PORT=5001
DATABASE_URL=postgres://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
APP_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=false
BOOTSTRAP_SECRET=one-time-admin-bootstrap-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=mail-provider-app-password
PASSWORD_RESET_URL=comalwaste://create-new-password
